{
  "name": "kirby-lingohub",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "kirbyup serve src/panel/index.ts",
    "build": "kirbyup src/panel/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" --write",
    "test:types": "tsc --noEmit",
    "release": "pnpm run build && bumpp --all --execute \"node scripts/pre-release.mjs\" && composer update"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "kirby-types": "^1.8.2",
    "kirbyup": "^3.5.0",
    "kirbyuse": "^1.4.2",
    "prettier": "^3.9.10",
    "tinyexec": "^1.3.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vue": "^2.7.16"
  }
}
