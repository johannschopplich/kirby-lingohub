{
  "name": "kirby-lingohub",
  "type": "module",
  "version": "1.3.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "kirbyup serve src/panel/index.js",
    "build": "kirbyup src/panel/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"src/panel/**\" --write",
    "release": "pnpm run build && bumpp --all --execute \"npx zx scripts/pre-release.mjs\" && zx scripts/post-release.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "kirbyup": "^3.5.0",
    "kirbyuse": "^1.4.2",
    "mitt": "^3.0.1",
    "prettier": "^3.9.10",
    "vite": "~6.3.7",
    "vue": "^2.7.16",
    "zx": "^8.8.5"
  }
}
